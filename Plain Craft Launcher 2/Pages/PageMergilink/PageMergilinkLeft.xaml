<local:MyPageRight
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PCL"
             x:Class="PageMergilinkLeft">
    <Grid>
        <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="25,10">
                <local:MyCard Title="MergiLink默连" Margin="0,0,0,15">
                    <StackPanel Margin="10,30,10,10">
                        <TextBlock LineHeight="23" FontSize="14" TextWrapping="Wrap" Margin="10,10,10,0"
                                   Text="1、进入世界后，在游戏菜单中选择【对局域网开放】&#xa;2、在下方选择此游戏实例，单击【启动】&#xa;3、成功启动后，复制日志中的连接信息并发送给你的朋友" />
                        <DockPanel Margin="10,10,10,0" Height="28">
                            <local:MyButton x:Name="BtnRefreshNodes" DockPanel.Dock="Right" Text="刷新节点" Width="70" Margin="5,0,0,0" ToolTip="刷新节点列表"/>
                            <TextBlock Text="节点：" VerticalAlignment="Center" Margin="5,0,5,0" Foreground="{DynamicResource ColorBrush3}"/>
                            <local:MyComboBox x:Name="ComboNodeList" HorizontalAlignment="Stretch"/>
                        </DockPanel>
                        <DockPanel Margin="10" Height="28">
                            <local:MyButton x:Name="BtnStart" DockPanel.Dock="Right" Text="启动" ColorType="Highlight" Width="80" Margin="10,0,0,0"/>
                            <local:MyButton x:Name="BtnStop" DockPanel.Dock="Right" Text="停止" ColorType="Red" Width="80" Margin="10,0,0,0" Visibility="Collapsed"/>
                            <local:MyButton x:Name="BtnSwitchMode" DockPanel.Dock="Right" Text="手动" Width="50" Margin="5,0,0,0" ToolTip="切换模式" />
                            <local:MyButton x:Name="BtnRefresh" DockPanel.Dock="Right" Text="刷新" Width="50" Margin="5,0,0,0" ToolTip="刷新列表" />
                            <TextBlock Text="房间：" VerticalAlignment="Center" Margin="5,0,5,0" Foreground="{DynamicResource ColorBrush3}"/>
                            <local:MyTextBox x:Name="TextPort" Text="61191" HintText="端口 (Port)" Visibility="Collapsed"/>
                            <local:MyComboBox x:Name="ComboWorldList" DropDownWidthSync="False"/>
                        </DockPanel>
                    </StackPanel>
                </local:MyCard>

                <local:MyCard Title="运行日志" Margin="0,0,0,15">
                     <TextBox x:Name="TextLog" Height="300" IsReadOnly="True" TextWrapping="Wrap" 
                              Background="Transparent" BorderThickness="0" 
                              Foreground="{DynamicResource ColorBrush1}" 
                              FontFamily="Consolas" VerticalScrollBarVisibility="Auto"
                              Margin="15,40,15,15"/>
                </local:MyCard>
                
            <local:MyCard Title="鸣谢">
                <StackPanel Margin="20,40,18,18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="45"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <local:MyListItem Title="XJHya" Margin="-5,0,0,0" IsHitTestVisible="False" Grid.ColumnSpan="2" Info="Dev" Grid.Row="0" Grid.Column="1" />
                        
                    </Grid>
                     <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="45"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <local:MyListItem Title="節點貢獻者" Margin="-5,0,0,0" IsHitTestVisible="False" Grid.ColumnSpan="2" Info="還沒寫完" Grid.Row="0" Grid.Column="1" />
                        
                    </Grid>
                </StackPanel>
            </local:MyCard>
            </StackPanel>
        </local:MyScrollViewer>
    </Grid>
</local:MyPageRight>
